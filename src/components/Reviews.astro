---
const reviews = [
  {
    quote:
      "Mateo tiene una mano increíble. El afeitado con las dos toallas calientes te deja como nuevo. Para mí, el mejor corte de Quito.",
    name: "Alejandro Valenzuela",
    role: "Cliente desde 2021 · El Completo del Barón",
  },
  {
    quote:
      "Llegas a tu hora y te atienden a tu hora. Buen ambiente, buena música y un degradado impecable de Diego. El café mientras esperas suma bastante.",
    name: "Carlos Ruiz",
    role: "Cumbayá · Degradado y peinado",
  },
  {
    quote:
      "Tengo la barba tupida y en ningún lado me la dejaban pareja. Carlos me la perfiló a navaja con una paciencia que no había visto antes.",
    name: "Javier Montero",
    role: "Quito · Arreglo de barba",
  },
];

const details = [
  { title: "Navaja nueva para cada cliente", desc: "Hoja descartable, se abre frente a ti." },
  { title: "Toallas calientes", desc: "Al vapor, con eucalipto." },
  { title: "Café o whisky", desc: "Café de altura ecuatoriano o un whisky, por la casa." },
  { title: "Sillones clásicos", desc: "Hidráulicos, de cuero, de los que ya no se hacen." },
];
---

<section id="opiniones" class="bg-night">
  <div class="shell flex flex-col gap-16 py-24">
    <div class="flex flex-col gap-6" data-reveal-stagger>
      <p class="eyebrow" data-reveal>Lo que dicen los clientes</p>
      <h2 class="section-title max-w-[820px]" data-reveal>
        Más de 1.400 clientes al mes <em>vuelven por algo.</em>
      </h2>
    </div>

    <div class="grid w-full grid-cols-1 gap-10 md:grid-cols-3 md:gap-8" data-reveal-stagger>
      {
        reviews.map((review) => (
          <figure data-reveal="left" class="flex flex-col justify-between gap-8 border-t border-gold/40 pt-6">
            <div class="flex flex-col gap-4">
              <p class="text-[13px] tracking-[0.2em] text-gold" aria-label="5 de 5 estrellas">★★★★★</p>
              <blockquote class="font-display text-[20px] leading-[1.45] text-snow">
                “{review.quote}”
              </blockquote>
            </div>
            <figcaption class="flex flex-col gap-0.5">
              <span class="text-[14px] font-semibold text-snow">{review.name}</span>
              <span class="text-[12px] text-steel">{review.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="grid w-full grid-cols-1 gap-px border-y border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        details.map((detail) => (
          <div data-reveal class="flex flex-col gap-1.5 bg-night px-1 py-6 sm:px-6">
            <p class="font-display text-[18px] text-snow">{detail.title}</p>
            <p class="text-[13px] leading-[1.5] text-steel">{detail.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
