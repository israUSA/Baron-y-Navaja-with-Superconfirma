---
import Icon from "./Icon.astro";

const links = [
  { label: "Inicio", href: "#inicio" },
  { label: "Servicios", href: "#servicios" },
  { label: "Barberos", href: "#barberos" },
  { label: "Opiniones", href: "#opiniones" },
  { label: "Reservas", href: "#reservas" },
];
---

<header class="site-header">
  <div class="shell">
    <div class="header-bar">
      <a href="#inicio" class="flex items-center gap-3" aria-label="BARÓN & NAVAJA - Inicio">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-full border border-gold/60 font-display text-[15px] text-gold italic"
        >
          B&amp;N
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display text-[21px] font-medium tracking-[0.06em] whitespace-nowrap text-snow">
            Barón &amp; Navaja
          </span>
          <span class="mt-1.5 text-[9px] font-semibold tracking-[0.28em] whitespace-nowrap text-gold">
            BARBERÍA CLÁSICA · QUITO
          </span>
        </span>
      </a>

      <nav class="hidden items-center gap-9 lg:flex" aria-label="Navegación principal">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link" data-nav>
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-5 lg:flex">
        <a
          href="https://wa.me/593987456930"
          class="inline-flex items-center gap-2 text-[13px] text-silver transition-colors hover:text-gold"
        >
          <Icon name="message-circle" class="h-4 w-4 text-gold" />
          099 745 6930
        </a>
        <a href="#reservas" class="btn btn-gold px-5 py-3">Reservar turno</a>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-[3px] border border-line text-snow lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span data-icon-menu><Icon name="menu" class="h-5 w-5" /></span>
        <span data-icon-close class="hidden"><Icon name="x" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu lg:hidden" data-mobile-menu>
    <nav class="flex flex-col gap-1 py-4" aria-label="Navegación móvil">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b border-line px-1 py-3 font-display text-xl text-snow transition-colors hover:text-gold"
          >
            {link.label}
          </a>
        ))
      }
      <a href="#reservas" class="btn btn-gold mt-4 w-full">Reservar turno</a>
    </nav>
  </div>
</header>
