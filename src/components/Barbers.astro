---
import Icon from "./Icon.astro";

const barbers = [
  {
    image: "/images/barber-mateo.jpg",
    alt: "Mateo Silva, Master Barber",
    initials: "MS",
    name: "Mateo Silva",
    role: "Master Barber & Director",
    specialty: "Cortes Clásicos & Navaja Libre • 10 años exp • Navaja libre",
    rating: "4.99 ★ (620 citas)",
    cta: "RESERVAR CON MATEO",
  },
  {
    image: "/images/barber-diego.jpg",
    alt: "Diego Valdés, Senior Fade Specialist",
    initials: "DV",
    name: "Diego Valdés",
    role: "Senior Fade Specialist",
    specialty: "Skin Fade, Taper & Estilo Urbano • 7 años exp • Skin Fade urbano",
    rating: "4.97 ★ (480 citas)",
    cta: "RESERVAR CON DIEGO",
  },
  {
    image: "/images/barber-carlos.jpg",
    alt: "Carlos Mendoza, Especialista en Barbas",
    initials: "CM",
    name: "Carlos Mendoza",
    role: "Especialista en Barbas",
    specialty: "Perfilado a Navaja & Visagismo • 8 años exp • Visagismo",
    rating: "4.98 ★ (510 citas)",
    cta: "RESERVAR CON CARLOS",
  },
  {
    image: "/images/barber-lucas.jpg",
    alt: "Lucas Ferreyra, Stylist & Peinados",
    initials: "LF",
    name: "Lucas Ferreyra",
    role: "Stylist & Peinados",
    specialty: "Pompadour, Textura & Asesoría • 6 años exp • Asesoría",
    rating: "4.95 ★ (390 citas)",
    cta: "RESERVAR CON LUCAS",
  },
];
---

<section id="barberos" class="border-b border-line bg-night">
  <div class="shell flex flex-col items-center gap-12 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>MAESTRÍA EN CADA SILLÓN</p>
      <h2 class="section-title" data-reveal>Nuestros Maestros Barberos Disponibles</h2>
      <p class="section-sub" data-reveal>
        Profesionales de élite con técnica certificada y pasión artesanal por el cuidado masculino.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger>
      {
        barbers.map((barber) => (
          <article
            data-reveal
            class="card-lift group flex flex-col overflow-hidden rounded-xl border border-line bg-night-card pb-5"
          >
            <div class="relative h-[230px] w-full overflow-hidden">
              <img
                src={barber.image}
                alt={barber.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.06]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-night-card/90 via-transparent to-night/40" />
              <span class="absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 rounded-[12px] border border-line bg-night px-2.5 py-1">
                <Icon name="circle-check" class="h-3 w-3 text-gold" />
                <span class="text-[9px] font-bold tracking-[0.08em] text-white">DISPONIBLE HOY</span>
              </span>
              <span class="absolute bottom-3.5 left-3.5 flex h-[52px] w-[52px] items-center justify-center rounded-full border border-gold-deep bg-night-raised font-display text-lg font-bold text-gold">
                {barber.initials}
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-2.5 px-5 pt-4">
              <div class="flex flex-col gap-0.5">
                <h3 class="font-display text-lg font-bold text-snow">{barber.name}</h3>
                <p class="text-xs font-semibold text-gold">{barber.role}</p>
              </div>
              <p class="text-[11px] leading-[1.4] text-silver">{barber.specialty}</p>
              <p class="flex items-center gap-1.5">
                <Icon name="star" class="h-3.5 w-3.5 text-gold" filled />
                <span class="text-[11px] font-semibold text-snow">{barber.rating}</span>
              </p>
            </div>

            <div class="px-5 pt-3">
              <a
                href="#reservas"
                class="btn btn-shine w-full rounded-md border border-gold-deep bg-night-raised py-2.5 text-[11px] tracking-[0.08em] text-gold hover:border-gold hover:bg-gold hover:text-night"
              >
                {barber.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
