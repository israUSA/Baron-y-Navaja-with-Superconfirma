---
const barbers = [
  {
    image: "/images/barber-mateo.jpg",
    alt: "Mateo Silva, barbero principal",
    name: "Mateo Silva",
    role: "Barbero principal y fundador",
    specialty: "Cortes clásicos y navaja libre",
    years: "10 años",
    rating: "4,99 · 620 citas",
    cta: "Reservar con Mateo",
  },
  {
    image: "/images/barber-diego.jpg",
    alt: "Diego Valdés, especialista en degradados",
    name: "Diego Valdés",
    role: "Especialista en degradados",
    specialty: "Degradado a piel, taper y estilo urbano",
    years: "7 años",
    rating: "4,97 · 480 citas",
    cta: "Reservar con Diego",
  },
  {
    image: "/images/barber-carlos.jpg",
    alt: "Carlos Mendoza, especialista en barbas",
    name: "Carlos Mendoza",
    role: "Especialista en barbas",
    specialty: "Perfilado a navaja y forma según tu cara",
    years: "8 años",
    rating: "4,98 · 510 citas",
    cta: "Reservar con Carlos",
  },
  {
    image: "/images/barber-lucas.jpg",
    alt: "Lucas Andrade, peinados y asesoría",
    name: "Lucas Andrade",
    role: "Peinados y asesoría",
    specialty: "Pompadour, textura y cambio de look",
    years: "6 años",
    rating: "4,95 · 390 citas",
    cta: "Reservar con Lucas",
  },
];
---

<section id="barberos" class="bg-night">
  <div class="shell flex flex-col gap-14 py-24">
    <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-12" data-reveal-stagger>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="eyebrow" data-reveal>Los del sillón</p>
        <h2 class="section-title" data-reveal>Cuatro barberos, <em>cada uno con su mano.</em></h2>
      </div>
      <p class="section-sub lg:col-span-4 lg:col-start-9" data-reveal>
        Elige al que mejor va con lo que buscas. Si no sabes cuál, pide el primer turno libre y
        te asesoramos ahí mismo.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger>
      {
        barbers.map((barber, i) => (
          <article data-reveal class="group flex flex-col">
            <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[4px]">
              <img
                src={barber.image}
                alt={barber.alt}
                loading="lazy"
                class="h-full w-full object-cover grayscale-[40%] transition-[filter,transform] duration-700 group-hover:scale-[1.03] group-hover:grayscale-0"
              />
              <span class="absolute top-4 left-4 font-display text-[15px] text-snow/80 italic">
                0{i + 1}
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-3 pt-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-[24px] leading-tight text-snow">{barber.name}</h3>
                <span class="text-[11px] whitespace-nowrap text-steel">{barber.years}</span>
              </div>
              <p class="text-[12px] font-semibold tracking-[0.14em] text-gold uppercase">
                {barber.role}
              </p>
              <p class="text-[14px] leading-[1.5] text-silver">{barber.specialty}</p>
              <p class="text-[12px] text-steel">★ {barber.rating}</p>
              <a
                href="#reservas"
                class="mt-auto inline-flex items-center gap-2 self-start border-b border-gold/50 pt-2 pb-1 text-[12px] font-semibold tracking-[0.12em] text-snow uppercase transition-colors hover:border-gold hover:text-gold"
              >
                {barber.cta} →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
