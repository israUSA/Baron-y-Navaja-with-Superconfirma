---
import Icon from "./Icon.astro";

const services = [
  {
    icon: "scissors",
    tag: "POPULAR",
    name: "Corte Signature & Styling",
    price: 24,
    duration: "40 min",
    desc: "Asesoramiento según facciones, corte a tijera o máquina, lavado con champú refrescante y peinado final.",
    cta: "RESERVAR ESTE SERVICIO",
    featured: false,
  },
  {
    icon: "sparkles",
    tag: "TRADICIÓN",
    name: "Afeitado Clásico a Navaja",
    price: 20,
    duration: "35 min",
    desc: "Aceite botánico pre-afeitado, doble toalla caliente al vapor, rasurado a navaja y loción astringente sin alcohol.",
    cta: "RESERVAR ESTE SERVICIO",
    featured: false,
  },
  {
    icon: "shield",
    tag: "ESENCIAL",
    name: "Esculpido & Ritual Barba",
    price: 18,
    duration: "30 min",
    desc: "Perfilado milimétrico de líneas en mejilla y cuello con navaja, rebaje de volumen y aceite nutritivo.",
    cta: "RESERVAR ESTE SERVICIO",
    featured: false,
  },
  {
    icon: "crown",
    tag: "TODO INCLUIDO",
    name: "Experiencia El Barón VIP",
    price: 38,
    duration: "65 min",
    desc: "Corte completo + Ritual de barba con toalla caliente + Masaje craneal relajante y café de especialidad o whisky.",
    cta: "RESERVAR EXPERIENCIA VIP",
    featured: true,
  },
];
---

<section id="servicios" class="border-b border-line bg-night-card">
  <div class="shell flex flex-col items-center gap-12 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>CARTA DE SERVICIOS &amp; PRECIOS</p>
      <h2 class="section-title" data-reveal>Cortes &amp; Tratamientos de Precisión</h2>
      <p class="section-sub" data-reveal>
        Cada experiencia incluye diagnóstico morfológico, lavado purificante y productos de
        cosmética masculina premium.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4" data-reveal-stagger>
      {
        services.map((service) => (
          <article
            data-reveal
            class:list={[
              "card-lift group flex flex-col justify-between gap-6 rounded-xl border p-6",
              service.featured
                ? "border-2 border-gold bg-night-raised"
                : "border-line bg-night",
            ]}
          >
            <div class="flex flex-col items-start gap-5">
              <div class="flex w-full items-center justify-between gap-2">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-night-raised transition-colors duration-500 group-hover:bg-gold group-hover:text-night text-gold">
                  <Icon name={service.icon} class="h-5 w-5" strokeWidth={1.8} />
                </span>
                <span
                  class:list={[
                    "inline-flex items-center rounded-[12px] border px-2.5 py-1 text-[10px] font-bold tracking-[0.08em]",
                    service.featured
                      ? "border-gold bg-gold text-night"
                      : "border-line bg-night-raised text-gold",
                  ]}
                >
                  {service.tag}
                </span>
              </div>

              <div class="flex flex-col gap-1">
                <h3 class="font-display text-[19px] font-bold text-snow">{service.name}</h3>
                <p class="flex items-baseline gap-1.5">
                  <span class="text-[22px] font-bold text-gold">{service.price}€</span>
                  <span class="text-[13px] text-steel">• {service.duration}</span>
                </p>
              </div>

              <p class="text-[13px] leading-5 text-silver">{service.desc}</p>
            </div>

            <a
              href="#reservas"
              class:list={[
                "btn w-full py-3 tracking-[0.06em]",
                service.featured
                  ? "btn-shine bg-gold text-night hover:brightness-110"
                  : "border border-line bg-transparent text-snow hover:border-gold hover:text-gold",
              ]}
            >
              {service.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
