---
const services = [
  {
    name: "Corte clásico",
    price: 18,
    duration: "40 min",
    desc: "Vemos juntos qué te queda según tu cara, corte a tijera o máquina, lavado y peinado.",
    note: "El más pedido",
    image: "/images/panel-cortes.jpg",
  },
  {
    name: "Afeitado a navaja",
    price: 15,
    duration: "35 min",
    desc: "Aceite antes de afeitar, dos toallas calientes, navaja y loción sin alcohol.",
    image: "/images/panel-afeitado.jpg",
  },
  {
    name: "Arreglo de barba",
    price: 12,
    duration: "30 min",
    desc: "Perfilado de mejilla y cuello a navaja, rebaje de volumen y aceite nutritivo.",
    image: "/images/panel-barba.jpg",
  },
  {
    name: "El Completo del Barón",
    price: 32,
    duration: "65 min",
    desc: "Corte, barba con toalla caliente y masaje de cabeza. Incluye café de especialidad o un whisky.",
    note: "Todo incluido",
    image: "/images/barber-mateo.jpg",
  },
];
---

<section id="servicios" class="bg-night-card">
  <div class="shell grid grid-cols-1 gap-14 py-24 lg:grid-cols-12 lg:gap-10">
    <div class="flex flex-col gap-6 lg:sticky lg:top-32 lg:col-span-4 lg:self-start" data-reveal-stagger>
      <p class="eyebrow" data-reveal>Carta de servicios</p>
      <h2 class="section-title" data-reveal>Precios <em>claros</em>, sin sorpresas.</h2>
      <p class="section-sub" data-reveal>
        Todos los servicios incluyen lavado y productos para el cuidado masculino. Pagas en la
        barbería, al terminar.
      </p>
      <a href="#reservas" class="btn btn-gold self-start" data-reveal>Reservar</a>
    </div>

    <div class="lg:col-span-7 lg:col-start-6" data-reveal-stagger>
      <div class="border-t border-line">
        {
          services.map((service) => (
            <article data-reveal="right" data-preview={service.image} class="menu-row group">
              <div class="menu-leader">
                <h3 class="font-display text-[clamp(22px,2.4vw,30px)] leading-tight text-snow transition-colors duration-300 group-hover:text-gold">
                  {service.name}
                </h3>
              </div>
              <p class="font-display text-[clamp(22px,2.4vw,30px)] text-gold">${service.price}</p>
              <div class="col-span-2 mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <p class="max-w-[520px] text-[14px] leading-[1.6] text-silver">{service.desc}</p>
              </div>
              <p class="col-span-2 mt-3 flex items-center gap-3 text-[11px] tracking-[0.16em] text-steel uppercase">
                {service.duration}
                {service.note && (
                  <>
                    <span class="text-gold">/</span>
                    <span class="text-gold">{service.note}</span>
                  </>
                )}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="menu-preview" data-menu-preview aria-hidden="true">
    {services.map((service) => <img src={service.image} alt="" loading="lazy" data-src={service.image} class="opacity-0" />)}
  </div>
</section>
