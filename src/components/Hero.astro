---
import Icon from "./Icon.astro";

const panels = [
  {
    image: "/images/panel-cortes.jpg",
    alt: "Barbero realizando un corte clásico a tijera",
    badge: "01 / TÉCNICA MILIMÉTRICA",
    price: "24€ • 40 min",
    title: "Cortes Clásicos & Fades",
    desc: "Tijera artesanal, Skin Fade, Taper y peinado con pomada mate importada.",
    featured: false,
  },
  {
    image: "/images/panel-afeitado.jpg",
    alt: "Afeitado clásico a navaja con toalla caliente",
    badge: "02 / EL RITUAL SIGNATURE ⭐",
    price: "20€ • 35 min",
    title: "Afeitado Clásico a Navaja",
    desc: "Aceite botánico pre-shave, doble toalla caliente al eucalipto, navaja japonesa y bálsamo facial.",
    featured: true,
  },
  {
    image: "/images/panel-barba.jpg",
    alt: "Perfilado de barba con navaja",
    badge: "03 / VISAGISMO & DISEÑO",
    price: "18€ • 30 min",
    title: "Esculpido & Ritual Barba",
    desc: "Perfilado milimétrico de líneas a navaja, rebaje de volumen y tratamiento de nutrición botánica.",
    featured: false,
  },
];

const trustPills = [
  {
    icon: "check",
    prefix: "+",
    target: 18500,
    decimals: 0,
    suffix: "",
    label: " Cortes Realizados",
  },
  {
    icon: "star",
    prefix: "",
    target: 4.9,
    decimals: 1,
    suffix: " ★ (1,450+ Reseñas Google)",
    label: "",
  },
  { icon: "sparkles", text: "Toalla Caliente & Navaja Libre" },
  { icon: "coffee", text: "Whisky o Café de Cortesía" },
];
---

<section id="inicio" class="border-b border-line bg-night">
  <div class="shell flex flex-col items-center gap-10 py-16 lg:gap-10 lg:py-16">
    <div class="flex flex-col items-center gap-5 text-center" data-reveal-stagger>
      <div
        data-reveal
        class="inline-flex items-center gap-2 rounded-full border border-gold-deep bg-night-raised px-4 py-1.5"
      >
        <Icon name="crown" class="h-3.5 w-3.5 text-gold" />
        <span class="text-[11px] leading-relaxed font-bold tracking-[0.18em] text-gold lg:whitespace-nowrap">
          TALLER DE BARBERÍA ARTESANAL • MAESTRÍA DESDE 2014
        </span>
      </div>

      <h1
        data-reveal
        class="max-w-[960px] font-display text-[clamp(38px,5.5vw,60px)] leading-[1.1] font-bold text-snow"
      >
        El Arte de la Distinción Masculina.
      </h1>

      <p data-reveal class="max-w-[820px] text-[17px] leading-[1.6] text-silver">
        No es solo un corte: es el ritual de precisión que define tu presencia y carácter. Fusionamos
        la maestría tradicional de la navaja caliente con el estilismo contemporáneo más refinado de
        la ciudad.
      </p>

      <div data-reveal class="flex flex-wrap items-center justify-center gap-4">
        <a href="#reservas" class="btn btn-gold btn-shine">
          <Icon name="calendar" class="h-4 w-4" strokeWidth={2.2} />
          RESERVAR TU CITA AHORA
        </a>
        <a href="#barberos" class="btn btn-outline">
          <Icon name="scissors" class="h-4 w-4 text-gold" />
          Ver Barberos &amp; Tratamientos
        </a>
      </div>

      <div data-reveal class="mt-2 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          trustPills.map((pill) => (
            <span class="flex items-center gap-1.5 text-xs font-medium text-silver">
              <Icon name={pill.icon} class="h-3.5 w-3.5 text-gold" />
              {pill.text ?? (
                <>
                  {pill.prefix}
                  <span data-counter data-target={pill.target} data-decimals={pill.decimals}>
                    {pill.target.toLocaleString("en-US", {
                      minimumFractionDigits: pill.decimals,
                    })}
                  </span>
                  {pill.suffix}
                  {pill.label}
                </>
              )}
            </span>
          ))
        }
      </div>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-3" data-reveal-stagger>
      {
        panels.map((panel) => (
          <article
            data-reveal
            class:list={[
              "triptych-panel card-lift group h-[420px] p-6",
              panel.featured ? "md:h-[400px] border-gold-deep" : "md:h-[370px]",
            ]}
          >
            <img
              src={panel.image}
              alt={panel.alt}
              class="animate-kenburns"
              loading={panel.featured ? "eager" : "lazy"}
            />
            <div class="relative flex w-full items-start justify-between gap-2">
              <span
                class:list={[
                  "inline-flex items-center rounded-[14px] border px-3 py-1.5 text-[10px] font-extrabold tracking-[0.08em]",
                  panel.featured
                    ? "border-gold bg-gold text-night"
                    : "border-gold-deep bg-night text-gold",
                ]}
              >
                {panel.badge}
              </span>
              <span class="inline-flex items-center rounded-[14px] border border-line bg-night px-3 py-1.5 text-[11px] font-bold whitespace-nowrap text-gold">
                {panel.price}
              </span>
            </div>
            <div class="relative flex w-full flex-col items-start gap-2 rounded-[10px] border border-line bg-night p-4">
              <h3 class="font-display text-[19px] font-bold text-snow">{panel.title}</h3>
              <p class="text-xs leading-[1.45] text-silver">{panel.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div
      data-reveal="fade"
      class="flex w-full flex-col items-start justify-between gap-4 rounded-[10px] border border-gold-deep bg-night-card p-4 sm:flex-row sm:items-center sm:px-6"
    >
      <div class="flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gold opacity-60"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-gold"></span>
        </span>
        <div class="flex flex-col gap-0.5">
          <p class="text-[13px] font-bold text-snow">
            4 Maestros Barberos de Turno Hoy (Mateo, Diego, Carlos, Lucas)
          </p>
          <p class="text-[11px] text-silver">
            Próximo turno libre disponible hoy: <span class="font-semibold text-gold">16:30 h</span> con Mateo Silva (Master Barber)
          </p>
        </div>
      </div>
      <a href="#reservas" class="btn btn-gold btn-shine w-full px-[18px] py-2.5 text-xs sm:w-auto">
        Reservar Este Horario
        <Icon name="arrow-right" class="h-3.5 w-3.5" strokeWidth={2.4} />
      </a>
    </div>
  </div>
</section>
