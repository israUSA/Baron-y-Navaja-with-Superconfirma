---
import Icon from "./Icon.astro";

const panels = [
  {
    image: "/images/panel-cortes.jpg",
    alt: "Barbero haciendo un corte clásico a tijera",
    label: "Corte",
    price: "$18 · 40 min",
    title: "Corte clásico y degradado",
    desc: "A tijera o máquina, degradado bajo o medio y peinado con pomada mate.",
  },
  {
    image: "/images/panel-afeitado.jpg",
    alt: "Afeitado a navaja con toalla caliente",
    label: "La especialidad de la casa",
    price: "$15 · 35 min",
    title: "Afeitado a navaja",
    desc: "Aceite antes de afeitar, dos toallas calientes con eucalipto, navaja y bálsamo para calmar la piel.",
  },
  {
    image: "/images/panel-barba.jpg",
    alt: "Perfilado de barba con navaja",
    label: "Barba",
    price: "$12 · 30 min",
    title: "Arreglo y perfilado de barba",
    desc: "Líneas marcadas a navaja, rebaje de volumen según tu cara y aceite para que no pique.",
  },
];

const facts = [
  { target: 18500, decimals: 0, suffix: "+", value: "18.500+", label: "cortes desde 2014" },
  { target: 4.9, decimals: 1, suffix: "", value: "4,9", label: "en Google · 1.450 reseñas" },
  { target: 4, decimals: 0, suffix: "", value: "4", label: "barberos en el sillón" },
  { value: "Café o whisky", label: "mientras esperas" },
];

const headline = [
  { word: "Tijera," },
  { word: "navaja" },
  { word: "y" },
  { word: "toalla", em: true },
  { word: "caliente.", em: true },
];
---

<section id="inicio" class="relative overflow-hidden bg-night">
  <div class="shell flex flex-col gap-14 pt-16 pb-20 lg:pt-20">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-7 lg:col-span-7" data-reveal-stagger>
        <p data-reveal class="eyebrow">Barbería clásica · La Carolina, Quito</p>

        <h1
          class="font-display text-[clamp(44px,6vw,88px)] leading-[0.95] font-medium tracking-[-0.02em] text-snow"
          aria-label="Tijera, navaja y toalla caliente."
        >
          {
            headline.map((item, i) => (
              <>
                <span class="rise-word" aria-hidden="true">
                  <span
                    style={`--i: ${i}`}
                    class:list={[item.em && "font-normal text-gold italic"]}
                  >
                    {item.word}
                  </span>
                </span>{" "}
              </>
            ))
          }
        </h1>

        <p data-reveal class="max-w-[560px] text-[16px] leading-[1.7] text-silver">
          Barbería de oficio, de las de antes: cortes a tijera, afeitado a navaja y barba bien
          perfilada, sin apuros. Te atendemos con o sin cita, y el café va por la casa.
        </p>

        <div data-reveal class="flex flex-wrap items-center gap-4">
          <a href="#reservas" class="btn btn-gold">
            Reservar mi turno
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href="#servicios" class="btn btn-outline">Ver precios</a>
        </div>
      </div>

      <div class="relative lg:col-span-5">
        <div
          data-reveal="image-side"
          class="relative aspect-[4/3] overflow-hidden rounded-[4px] sm:aspect-[5/4] lg:aspect-[4/5]"
        >
          <img
            src="/images/hero-barberia.jpg"
            alt="Interior de la barbería con la fila de sillones clásicos y lámparas colgantes"
            loading="eager"
            fetchpriority="high"
            data-parallax="0.12"
            class="absolute inset-x-0 -top-[9%] h-[118%] w-full object-cover"
          />
          <div class="absolute inset-0 bg-linear-to-t from-night/60 via-transparent to-transparent"></div>
          <p class="absolute right-5 bottom-4 text-[10px] tracking-[0.22em] text-snow/80 uppercase">
            El taller · La Carolina
          </p>
        </div>
        <div
          class="absolute -bottom-10 -left-10 hidden h-[170px] w-[170px] rounded-full bg-night p-1.5 lg:block"
          aria-hidden="true"
          data-reveal="fade"
          style="--reveal-delay: 900ms"
        >
          <svg viewBox="0 0 200 200" class="animate-spin-slow absolute inset-0 h-full w-full">
            <defs>
              <path id="seal-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
            </defs>
            <text
              fill="currentColor"
              class="text-gold"
              style="font: 600 13.5px Archivo, sans-serif; letter-spacing: 0.32em;"
            >
              <textPath href="#seal-circle">BARÓN &amp; NAVAJA · QUITO · DESDE 2014 ·</textPath>
            </text>
          </svg>
          <div class="absolute inset-[42px] flex flex-col items-center justify-center rounded-full border border-gold/40">
            <Icon name="scissors" class="snip h-7 w-7 text-gold" strokeWidth={1.5} />
            <span class="mt-1 font-display text-sm text-snow italic">est. 2014</span>
          </div>
        </div>
      </div>
    </div>

    <dl
      data-reveal
      class="grid grid-cols-2 border-y border-line lg:grid-cols-4"
    >
      {
        facts.map((fact, i) => (
          <div
            class:list={[
              "flex flex-col gap-1 py-5",
              i % 2 === 1 && "border-l border-line pl-5",
              i >= 2 && "border-t border-line lg:border-t-0",
              i === 2 && "lg:border-l lg:pl-5",
              i === 3 && "lg:pl-5",
            ]}
          >
            <dt class="order-2 text-[12px] text-steel">{fact.label}</dt>
            <dd class="order-1 font-display text-[26px] leading-none text-snow">
              {fact.target === undefined ? (
                fact.value
              ) : (
                <>
                  <span data-counter data-target={fact.target} data-decimals={fact.decimals}>
                    {fact.value.replace(fact.suffix, "")}
                  </span>
                  {fact.suffix}
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-3 md:items-end" data-reveal-stagger>
      {
        panels.map((panel, i) => (
          <article
            data-reveal="image"
            class:list={[
              "triptych-panel group p-5",
              i === 1 ? "h-[440px] md:h-[480px]" : "h-[400px]",
            ]}
          >
            <img
              src={panel.image}
              alt={panel.alt}
              class="animate-kenburns"
              loading={i === 1 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-linear-to-t from-night via-night/30 to-night/10"></div>

            <div class="relative flex items-start justify-between gap-3">
              <span
                class:list={[
                  "text-[10px] font-semibold tracking-[0.22em] uppercase",
                  i === 1 ? "bg-gold px-2.5 py-1 text-night" : "text-snow",
                ]}
              >
                {panel.label}
              </span>
              <span class="font-display text-[15px] whitespace-nowrap text-gold-soft">
                {panel.price}
              </span>
            </div>

            <div class="relative flex flex-col gap-2 border-t border-snow/20 pt-4">
              <h3 class="font-display text-[24px] leading-tight text-snow">{panel.title}</h3>
              <p class="text-[13px] leading-[1.55] text-silver">{panel.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div
      data-reveal="fade"
      class="flex w-full flex-col items-start justify-between gap-4 border-l-2 border-gold bg-night-card p-5 sm:flex-row sm:items-center sm:px-7"
    >
      <div class="flex flex-col gap-1">
        <p class="text-[14px] font-semibold text-snow">
          Hoy atienden Mateo, Diego, Carlos y Lucas.
        </p>
        <p class="text-[13px] text-silver">
          Próximo turno libre: <span class="font-semibold text-gold">16:30</span> con Mateo Silva.
        </p>
      </div>
      <a href="#reservas" class="btn btn-outline w-full px-5 py-3 sm:w-auto">
        Tomar ese turno
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
  <div class="pole"></div>
</section>
