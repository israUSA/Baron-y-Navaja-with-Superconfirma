---
import Icon from "./Icon.astro";

const hours = [
  { days: "Lunes a Viernes", time: "09:30 - 20:30" },
  { days: "Sábados", time: "09:00 - 20:00" },
  { days: "Domingos & Festivos", time: "Cerrado (Descanso de navajas)" },
];

const contact = [
  "Calle Serrano 48, Barrio de Salamanca, 28001 Madrid",
  "Teléfono directo: +34 910 248 930",
  "WhatsApp Citas: +34 612 345 678",
  "Email: reservas@baronynavaja.es",
];
---

<footer class="border-t border-line bg-night-deep">
  <div class="shell flex flex-col gap-10 py-16 pb-10">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.2fr_1fr_1.2fr] lg:gap-16">
      <div class="flex flex-col gap-4">
        <p class="flex items-center gap-2.5 font-display text-xl font-bold tracking-[0.1em] text-snow">
          <Icon name="scissors" class="h-5 w-5 text-gold" />
          BARÓN &amp; NAVAJA
        </p>
        <p class="max-w-sm text-[13px] leading-[1.6] text-silver">
          Taller de corte masculino clásico, afeitado a navaja caliente y cuidado de barba de alta
          distinción. Un espacio creado para el caballero moderno.
        </p>
      </div>

      <div class="flex flex-col gap-3.5">
        <p class="text-xs font-bold tracking-[0.14em] text-gold">HORARIO DE ATENCIÓN</p>
        <div class="flex flex-col gap-3">
          {
            hours.map((row) => (
              <div class="flex flex-col gap-0.5">
                <p class="text-xs font-semibold text-snow">{row.days}</p>
                <p class="text-xs text-steel">{row.time}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <p class="text-xs font-bold tracking-[0.14em] text-gold">UBICACIÓN &amp; CONTACTO</p>
        <div class="flex flex-col gap-2">
          {
            contact.map((line) => (
              <p class="text-xs leading-[1.5] text-silver">{line}</p>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-3 border-t border-line pt-6 sm:flex-row"
    >
      <p class="text-xs text-steel">
        © 2026 BARÓN &amp; NAVAJA — Taller de Barbería. Todos los derechos reservados.
      </p>
      <p class="text-xs text-steel">Aviso Legal • Política de Privacidad • Cancelaciones</p>
    </div>
  </div>
</footer>
