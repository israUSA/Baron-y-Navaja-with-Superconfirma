---
import Icon from "./Icon.astro";

const barbers = [
  { name: "Cualquier Barbero", role: "El primer turno libre" },
  { name: "Mateo Silva", role: "Barbero principal", selected: true },
  { name: "Diego Valdés", role: "Degradados" },
  { name: "Carlos Mendoza", role: "Barbas" },
  { name: "Lucas Andrade", role: "Peinados" },
];

const services = [
  { icon: "scissors", name: "Corte clásico", time: "40 min", price: 18 },
  { icon: "shield", name: "Afeitado a navaja", time: "35 min", price: 15 },
  { icon: "user", name: "Arreglo de barba", time: "30 min", price: 12 },
  { icon: "crown", name: "El Completo del Barón", time: "65 min", price: 32, selected: true },
];

const days = [
  { tag: "HOY", num: "Mié 30" },
  { tag: "MAÑANA", num: "Jue 1", selected: true },
  { tag: "VIE", num: "2 Oct" },
  { tag: "SÁB", num: "3 Oct" },
  { tag: "LUN", num: "5 Oct" },
];

const hours = ["10:00", "11:30", "14:00", "16:30", "18:00", "19:15"];
const selectedHour = "16:30";

const trust = [
  "No cobramos nada por adelantado: pagas al terminar.",
  "Puedes cancelar sin costo hasta 2 horas antes.",
  "Te confirmamos por WhatsApp.",
];
---

<section id="reservas" class="bg-night-card">
  <div class="pole"></div>
  <div class="shell grid grid-cols-1 gap-12 py-24 lg:grid-cols-12 lg:gap-10">
    <div class="flex flex-col gap-6 lg:sticky lg:top-32 lg:col-span-4 lg:self-start" data-reveal-stagger>
      <p class="eyebrow" data-reveal>Reservas en línea</p>
      <h2 class="section-title" data-reveal>Separa tu turno <em>en un minuto.</em></h2>
      <p class="section-sub" data-reveal>
        Elige barbero, servicio y hora. Te llega la confirmación por WhatsApp al instante.
      </p>
      <ul class="flex flex-col gap-3 border-t border-line pt-6" data-reveal>
        {
          trust.map((item) => (
            <li class="flex items-start gap-3 text-[13px] leading-[1.5] text-silver">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      data-reveal
      class="flex flex-col gap-10 border border-line bg-night p-6 sm:p-9 lg:col-span-8"
    >
      <div class="flex flex-col gap-4">
        <div class="step-head">
          <span class="step-num">1</span>
          <h3 class="step-title">¿Con quién te quieres cortar?</h3>
        </div>
        <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-5" data-select-group data-group-barbers>
          {
            barbers.map((barber) => (
              <button
                type="button"
                data-select-option
                data-barber-name={barber.name}
                class:list={["wizard-chip", barber.selected && "is-selected"]}
                aria-pressed={barber.selected ? "true" : "false"}
              >
                <span class="flex min-w-0 flex-col">
                  <span class="chip-name truncate">{barber.name}</span>
                  <span class="chip-role truncate">{barber.role}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="step-head">
          <span class="step-num">2</span>
          <h3 class="step-title">¿Qué te hacemos?</h3>
        </div>
        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2" data-select-group data-group-services>
          {
            services.map((service) => (
              <button
                type="button"
                data-select-option
                data-service-name={service.name}
                data-service-price={service.price}
                class:list={["service-option", service.selected && "is-selected"]}
                aria-pressed={service.selected ? "true" : "false"}
              >
                <span class="flex items-center gap-3">
                  <Icon name={service.icon} class="h-4 w-4 shrink-0 text-gold" strokeWidth={1.6} />
                  <span class="flex flex-col">
                    <span class="s-name">{service.name}</span>
                    <span class="text-[11px] text-steel">{service.time}</span>
                  </span>
                </span>
                <span class="flex items-center gap-3">
                  <span class="font-display text-[18px] text-snow">${service.price}</span>
                  <Icon
                    name={service.selected ? "circle-check" : "circle"}
                    class:list={["service-radio", service.selected && "text-gold"]}
                  />
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="step-head">
          <span class="step-num">3</span>
          <h3 class="step-title">Día y hora</h3>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-3">
            <p class="text-[12px] text-steel">Esta semana</p>
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-5" data-select-group>
              {
                days.map((day) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["day-pill", day.selected && "is-selected"]}
                    aria-pressed={day.selected ? "true" : "false"}
                  >
                    <span class="day-tag">{day.tag}</span>
                    <span class="day-num">{day.num}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-[12px] text-steel" data-times-label>Horarios con Mateo Silva:</p>
            <div class="grid grid-cols-3 gap-2" data-select-group>
              {
                hours.map((hour) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["hour-pill", hour === selectedHour && "is-selected"]}
                    aria-pressed={hour === selectedHour ? "true" : "false"}
                  >
                    {hour}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="step-head">
          <span class="step-num">4</span>
          <h3 class="step-title">Tus datos</h3>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          <div class="flex flex-col gap-1">
            <label for="booking-name" class="text-[12px] text-steel">Nombre</label>
            <div class="input-frame">
              <Icon name="user" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input id="booking-name" name="nombre" type="text" placeholder="Ej. Andrés Paredes" autocomplete="name" />
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label for="booking-phone" class="text-[12px] text-steel">Celular / WhatsApp</label>
            <div class="input-frame">
              <Icon name="phone" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input id="booking-phone" name="telefono" type="tel" placeholder="Ej. 099 123 4567" autocomplete="tel" />
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label for="booking-notes" class="text-[12px] text-steel">Algo que debamos saber</label>
            <div class="input-frame">
              <Icon name="edit" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input id="booking-notes" name="notas" type="text" placeholder="Ej. Solo tijera, nada de máquina" />
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-gold w-full py-5 text-[12px]">
        <span data-confirm-cta>Confirmar reserva con Mateo Silva · pagas en la barbería ($32)</span>
      </button>
    </div>
  </div>
</section>
