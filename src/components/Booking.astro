---
import Icon from "./Icon.astro";

const barbers = [
  { icon: "sparkles", name: "Cualquier Barbero", role: "Turno más rápido" },
  { icon: "circle-check", name: "Mateo Silva", role: "Master Barber", selected: true },
  { icon: "user", name: "Diego Valdés", role: "Fade Specialist" },
  { icon: "user", name: "Carlos Mendoza", role: "Barba Specialist" },
  { icon: "user", name: "Lucas Ferreyra", role: "Stylist & Peinado" },
];

const services = [
  { icon: "scissors", name: "Corte Signature", time: "40 min", price: 24 },
  { icon: "sparkles", name: "Afeitado Tradicional", time: "35 min", price: 20 },
  { icon: "shield", name: "Esculpido de Barba", time: "30 min", price: 18 },
  {
    icon: "crown",
    name: "Experiencia El Barón VIP",
    time: "65 min",
    price: 38,
    selected: true,
  },
];

const days = [
  { tag: "HOY", num: "Jue 24" },
  { tag: "MAÑANA", num: "Vie 25", selected: true },
  { tag: "SÁB", num: "26 Sep" },
  { tag: "LUN", num: "28 Sep" },
  { tag: "MAR", num: "29 Sep" },
];

const hours = ["10:00", "11:30", "14:00", "16:30", "18:00", "19:15"];
const selectedHour = "16:30";

const trust = [
  { icon: "shield", text: "Sin cobro anticipado • Pagas tras el servicio" },
  { icon: "schedule", text: "Cancelación gratuita hasta 2 horas antes" },
  { icon: "coffee", text: "Whisky de malta o café espresso de cortesía" },
];
---

<section id="reservas" class="border-b border-line bg-night-card">
  <div class="shell flex flex-col items-center gap-10 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>SISTEMA DE CITAS EN TIEMPO REAL</p>
      <h2 class="section-title" data-reveal>Reserva tu Cita en 4 Pasos</h2>
      <p class="section-sub" data-reveal>
        Elige tu maestro barbero, el tratamiento que deseas y tu horario preferido. Confirmación
        instantánea por WhatsApp.
      </p>
    </div>

    <div
      data-reveal="zoom"
      class="flex w-full max-w-[1040px] flex-col gap-8 rounded-2xl border border-gold-deep bg-night p-6 sm:p-9"
    >
      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-md bg-gold px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] text-night">
            PASO 1
          </span>
          <h3 class="font-display text-lg font-bold text-snow">
            Selecciona tu Barbero Preferido
          </h3>
        </div>
        <div
          class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"
          data-select-group
          data-group-barbers
        >
          {
            barbers.map((barber) => (
              <button
                type="button"
                data-select-option
                data-barber-name={barber.name}
                class:list={["wizard-chip", barber.selected && "is-selected"]}
                aria-pressed={barber.selected ? "true" : "false"}
              >
                <Icon
                  name={barber.icon}
                  class:list={["h-4 w-4 shrink-0", barber.selected ? "text-gold" : "text-steel"]}
                />
                <span class="flex min-w-0 flex-col">
                  <span class="chip-name truncate">{barber.name}</span>
                  <span class="chip-role truncate">{barber.role}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-md bg-gold px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] text-night">
            PASO 2
          </span>
          <h3 class="font-display text-lg font-bold text-snow">
            Selecciona el Servicio o Experiencia
          </h3>
        </div>
        <div
          class="grid grid-cols-1 gap-3 sm:grid-cols-2"
          data-select-group
          data-group-services
        >
          {
            services.map((service) => (
              <button
                type="button"
                data-select-option
                data-service-name={service.name}
                data-service-price={service.price}
                class:list={["service-option", service.selected && "is-selected"]}
                aria-pressed={service.selected ? "true" : "false"}
              >
                <span class="flex items-center gap-2.5">
                  <Icon name={service.icon} class="h-4 w-4 shrink-0 text-gold" />
                  <span class="flex flex-col">
                    <span class="s-name">{service.name}</span>
                    <span class="text-[10px] text-steel">{service.time}</span>
                  </span>
                </span>
                <span class="flex items-center gap-2.5">
                  <span class="text-[15px] font-bold text-snow">{service.price}€</span>
                  <Icon
                    name={service.selected ? "circle-check" : "circle"}
                    class:list={["service-radio", service.selected && "text-gold"]}
                  />
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-md bg-gold px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] text-night">
            PASO 3
          </span>
          <h3 class="font-display text-lg font-bold text-snow">Fecha y Horario Disponible</h3>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-3">
            <p class="text-[11px] font-semibold text-silver">Días Disponibles Esta Semana:</p>
            <div class="grid grid-cols-3 gap-2.5 sm:grid-cols-5" data-select-group>
              {
                days.map((day) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["day-pill", day.selected && "is-selected"]}
                    aria-pressed={day.selected ? "true" : "false"}
                  >
                    <span class="day-tag">{day.tag}</span>
                    <span class="day-num">{day.num}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-[11px] font-semibold text-silver" data-times-label>
              Horarios con Mateo Silva:
            </p>
            <div class="grid grid-cols-3 gap-2.5" data-select-group>
              {
                hours.map((hour) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["hour-pill", hour === selectedHour && "is-selected"]}
                    aria-pressed={hour === selectedHour ? "true" : "false"}
                  >
                    {hour}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-md bg-gold px-2.5 py-1 text-[10px] font-extrabold tracking-[0.08em] text-night">
            PASO 4
          </span>
          <h3 class="font-display text-lg font-bold text-snow">
            Tus Datos de Contacto para Confirmación
          </h3>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="flex flex-col gap-1.5">
            <label for="booking-name" class="text-[11px] text-silver">Nombre Completo</label>
            <div class="input-frame">
              <Icon name="user" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input
                id="booking-name"
                name="nombre"
                type="text"
                placeholder="Ej. Alejandro Morales"
                autocomplete="name"
              />
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="booking-phone" class="text-[11px] text-silver">Teléfono / WhatsApp</label>
            <div class="input-frame">
              <Icon name="phone" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input
                id="booking-phone"
                name="telefono"
                type="tel"
                placeholder="Ej. +34 612 345 678"
                autocomplete="tel"
              />
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="booking-notes" class="text-[11px] text-silver">Notas o Preferencias</label>
            <div class="input-frame">
              <Icon name="edit" class="h-3.5 w-3.5 shrink-0 text-steel" />
              <input
                id="booking-notes"
                name="notas"
                type="text"
                placeholder="Ej. Café con hielo y corte a tijera"
              />
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-gold btn-shine w-full py-[18px] text-sm">
        <Icon name="circle-check" class="h-4.5 w-4.5" strokeWidth={2.2} />
        <span data-confirm-cta>
          CONFIRMAR RESERVA CON MATEO SILVA — PAGO EN LA BARBERÍA (38€)
        </span>
      </button>

      <div class="flex flex-col items-center justify-center gap-3 border-t border-line pt-5 sm:flex-row sm:gap-7">
        {
          trust.map((item) => (
            <div class="flex items-center gap-1.5">
              <Icon name={item.icon} class="h-3.5 w-3.5 shrink-0 text-gold" />
              <p class="text-[11px] text-silver">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
