---
import Icon from "./Icon.astro";

const barbers = [
  { name: "Cualquier Barbero", role: "El primer turno libre" },
  { name: "Mateo Silva", role: "Barbero principal", selected: true },
  { name: "Diego Valdés", role: "Degradados" },
  { name: "Carlos Mendoza", role: "Barbas" },
  { name: "Lucas Andrade", role: "Peinados" },
];

const services = [
  { icon: "scissors", name: "Corte clásico", time: "40 min", price: 18 },
  { icon: "shield", name: "Afeitado a navaja", time: "35 min", price: 15 },
  { icon: "user", name: "Arreglo de barba", time: "30 min", price: 12 },
  { icon: "crown", name: "El Completo del Barón", time: "65 min", price: 32, selected: true },
];

const days = [
  { tag: "HOY", num: "Mié 30" },
  { tag: "MAÑANA", num: "Jue 1", selected: true },
  { tag: "VIE", num: "2 Oct" },
  { tag: "SÁB", num: "3 Oct" },
  { tag: "LUN", num: "5 Oct" },
];

const hours = ["10:00", "11:30", "14:00", "16:30", "18:00", "19:15"];
const selectedHour = "16:30";

const trust = [
  "No cobramos nada por adelantado: pagas al terminar.",
  "Puedes cancelar sin costo hasta 2 horas antes.",
  "Te confirmamos por WhatsApp.",
];
---

<section id="reservas" class="bg-night-card">
  <div class="pole"></div>
  <div class="shell grid grid-cols-1 gap-12 py-24 lg:grid-cols-12 lg:gap-10">
    <div class="flex flex-col gap-6 lg:sticky lg:top-32 lg:col-span-4 lg:self-start" data-reveal-stagger>
      <p class="eyebrow" data-reveal>Reservas en línea</p>
      <h2 class="section-title" data-reveal>Separa tu turno <em>en un minuto.</em></h2>
      <p class="section-sub" data-reveal>
        Elige barbero, servicio y hora. Te llega la confirmación por WhatsApp al instante.
      </p>
      <ul class="flex flex-col gap-3 border-t border-line pt-6" data-reveal>
        {
          trust.map((item) => (
            <li class="flex items-start gap-3 text-[13px] leading-[1.5] text-silver">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <style>
  :root {
    --sc-accent: #c9a15b;
    --sc-accent-contrast: #100e0c;
    --sc-surface: #100e0c;
    --sc-card: #171512;
    --sc-ink: #efe8dc;
  }
</style>
 <div class="lg:col-span-8" data-reveal="right">
      <div id="superconfirma"></div>
      <script is:inline src="http://localhost:4340/widget.js" data-slug="baron-y-navaja" data-target="#superconfirma"></script>
    </div>
    
  </div>
</section>





